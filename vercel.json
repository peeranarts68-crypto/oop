{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/web/style.css"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/psru_icon.jpg",
      "destination": "/web/psru_icon.jpg"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/web/uploads/:path*"
    }
  ]
}